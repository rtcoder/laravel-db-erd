{
  "name": "rtcoder/laravel-db-erd",
  "description": "Laravel package to generate database ERD diagrams.",
  "type": "library",
  "license": "MIT",
  "prefer-stable": true,
  "version": "0.2.0",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.48.29|^11.44.1|^12.1.1"
  },
  "scripts": {
    "test": "phpunit --testdox"
  },
  "autoload": {
    "psr-4": {
      "Rtcoder\\LaravelERD\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Rtcoder\\LaravelERD\\Providers\\ERDServiceProvider"
      ]
    }
  },
  "authors": [
    {
      "name": "Dawid Jeż",
      "email": "dawidjez@gmail.com"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  }
}
